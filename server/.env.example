NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Platform SQL Server - optional during development
PLATFORM_DB_SERVER=
PLATFORM_DB_PORT=1433
PLATFORM_DB_DATABASE=
PLATFORM_DB_USER=
PLATFORM_DB_PASSWORD=
PLATFORM_DB_ENCRYPT=false
PLATFORM_DB_TRUST_SERVER_CERTIFICATE=true

# Authentication - leave empty to expose AUTH_NOT_CONFIGURED in development
JWT_SECRET=
JWT_EXPIRES_IN=8h

# One-time first administrator bootstrap token.
BOOTSTRAP_ADMIN_TOKEN=

# 32-byte key encoded as Base64, used only to encrypt DataSource passwords at rest.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATASOURCE_ENCRYPTION_KEY=

# Oracle driver mode.
# THIN requires no Oracle Client and is preferred when the target Oracle version supports it.
# If connection test reports NJS-138, switch to THICK and configure Oracle Instant Client.
# Changing THIN/THICK requires restarting the backend because node-oracledb mode is fixed per process.
ORACLE_DRIVER_MODE=THIN
# Windows example: C:\oracle\instantclient_23_26
# Leave empty in THIN mode. In THICK mode, set this to the Instant Client directory.
ORACLE_CLIENT_LIB_DIR=
