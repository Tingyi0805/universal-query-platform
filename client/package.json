{
  "name": "universal-query-platform-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json",
    "test": "node --import tsx --test src/dashboard/*.test.ts src/security/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.1",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <13"
  },
  "packageManager": "npm@12.2.1"
}
