-- 2B-12 / 928 CHART schema proposal -- NON-SCANNED DRAFT.
-- DO NOT MOVE TO database/migrations, db:migrate or production installer
-- without independent approval, 925 exact schema attestation and 2B-13 writer integration.
-- Validates isolated SQL Server 2019/2022 only; this does NOT enable a CHART.
SET XACT_ABORT ON;
DECLARE @ownsTransaction bit=CASE WHEN @@TRANCOUNT=0 THEN 1 ELSE 0 END;
BEGIN TRY
 IF @ownsTransaction=1 BEGIN TRANSACTION;
 ELSE SAVE TRANSACTION Chart928Draft;
 DECLARE @lockResult int;
 EXEC @lockResult=sys.sp_getapplock @Resource=N'UQP:928:ChartTrustDraft',
   @LockMode=N'Exclusive',@LockOwner=N'Transaction',@LockTimeout=10000;
 IF @lockResult<0 THROW 51928,'CHART_928_SCHEMA_LOCK_REQUIRED',1;
 IF OBJECT_ID(N'uqp.Dashboard',N'U') IS NULL
    OR OBJECT_ID(N'uqp.DashboardDisplayProfile',N'U') IS NULL
    OR OBJECT_ID(N'uqp.DashboardWidget',N'U') IS NULL
    OR OBJECT_ID(N'uqp.AppUser',N'U') IS NULL
    OR OBJECT_ID(N'uqp.Dataset',N'U') IS NULL
    OR OBJECT_ID(N'uqp.QueryDefinition',N'U') IS NULL
    OR OBJECT_ID(N'uqp.AuditLog',N'U') IS NULL
    OR OBJECT_ID(N'uqp.DatasetPublicDisplayPolicy',N'U') IS NULL
    OR COL_LENGTH(N'uqp.DashboardWidget',N'ConfigJson') IS NULL
    OR COL_LENGTH(N'uqp.DashboardWidget',N'WidgetType') IS NULL
    OR COL_LENGTH(N'uqp.DashboardWidget',N'SourceKey') IS NULL
    OR COL_LENGTH(N'uqp.AuditLog',N'EventCategory') IS NULL
    OR COL_LENGTH(N'uqp.AuditLog',N'IsImportant') IS NULL
    OR COL_LENGTH(N'uqp.AuditLog',N'EventType') IS NULL
    OR COL_LENGTH(N'uqp.AuditLog',N'UserId') IS NULL
    OR COL_LENGTH(N'uqp.AuditLog',N'Status') IS NULL
    OR OBJECT_ID(N'uqp.AuditLogArchive',N'U') IS NULL
    OR COL_LENGTH(N'uqp.AuditLogArchive',N'EventType') IS NULL
    OR COL_LENGTH(N'uqp.AuditLogArchive',N'IsImportant') IS NULL
    OR COL_LENGTH(N'uqp.AuditLogArchive',N'UserId') IS NULL
    OR COL_LENGTH(N'uqp.AuditLogArchive',N'Status') IS NULL
  THROW 51928,'CHART_928_PREREQUISITES_REQUIRED',1;

 DECLARE @count int=
  CASE WHEN OBJECT_ID(N'uqp.DashboardChartWidgetSeal',N'U') IS NULL THEN 0 ELSE 1 END+
  CASE WHEN OBJECT_ID(N'uqp.DashboardChartPrivacyReview',N'U') IS NULL THEN 0 ELSE 1 END+
  CASE WHEN OBJECT_ID(N'uqp.DashboardChartTrustRequest',N'U') IS NULL THEN 0 ELSE 1 END;
 IF @count NOT IN (0,3)
  THROW 51928,'CHART_928_PARTIAL_SCHEMA',1;
 IF @count=0
 BEGIN
  IF EXISTS(SELECT 1 FROM sys.objects WHERE schema_id=SCHEMA_ID(N'uqp')
   AND name IN(
    N'TR_DashboardWidget_ChartFreeze',N'TR_ChartSeal_DeleteBlock',
    N'TR_ChartReview_Transition',N'TR_ChartTrustRequest_Immutable',
    N'TR_ChartSeal_AuditReceipt',N'TR_ChartReview_AuditReceipt',
    N'TR_ChartTrustRequest_AuditReceipt',
    N'CK_ChartReview_State',N'CK_ChartTrustRequest_Action',
    N'CK_ChartSeal_Digest',N'UX_ChartReview_Active'))
   THROW 51928,'CHART_928_NAME_CONFLICT',1;
  IF EXISTS(SELECT 1 FROM uqp.DashboardWidget WHERE WidgetType=N'CHART')
   THROW 51928,'CHART_928_UNSEALED_EXISTING_WIDGET',1;
  IF NOT EXISTS (SELECT 1 FROM sys.check_constraints
    WHERE parent_object_id=OBJECT_ID(N'uqp.DashboardWidget')
     AND name=N'CK_DashboardWidget_Type'
     AND is_disabled=0 AND is_not_trusted=0 AND is_not_for_replication=0
     AND definition NOT LIKE N'%CHART%')
   THROW 51928,'CHART_928_BASE_WIDGET_CHECK_MISMATCH',1;

  CREATE TABLE uqp.DashboardChartWidgetSeal(
   WidgetId bigint NOT NULL CONSTRAINT PK_DashboardChartWidgetSeal PRIMARY KEY,
   ConfigDigest char(64) COLLATE Latin1_General_100_BIN2 NOT NULL,
   IsActive bit NOT NULL CONSTRAINT DF_ChartSeal_Active DEFAULT(0),
   SealedBy bigint NOT NULL,
   AuditLogId bigint NOT NULL,
   SealRowVersion rowversion NOT NULL,
   CreatedAtUtc datetime2(3) NOT NULL CONSTRAINT DF_ChartSeal_Created DEFAULT SYSUTCDATETIME(),
   CONSTRAINT FK_ChartSeal_Widget FOREIGN KEY(WidgetId) REFERENCES uqp.DashboardWidget(Id),
   CONSTRAINT FK_ChartSeal_User FOREIGN KEY(SealedBy) REFERENCES uqp.AppUser(Id),
   CONSTRAINT CK_ChartSeal_Digest CHECK(LEN(ConfigDigest)=64 AND ConfigDigest NOT LIKE '%[^0-9a-f]%')
  );
  CREATE TABLE uqp.DashboardChartTrustRequest(
   RequestId uniqueidentifier NOT NULL CONSTRAINT PK_DashboardChartTrustRequest PRIMARY KEY,
   Action nvarchar(40) NOT NULL,
   ActorId bigint NOT NULL,
   AuditLogId bigint NULL,
   CONSTRAINT FK_ChartRequest_Actor FOREIGN KEY(ActorId) REFERENCES uqp.AppUser(Id),
   CONSTRAINT CK_ChartTrustRequest_Action CHECK(Action IN
     (N'SEAL_WIDGET',N'REQUEST_REVIEW',N'APPROVE_REVIEW',N'REVOKE_REVIEW'))
  );
  CREATE TABLE uqp.DashboardChartPrivacyReview(
   Id bigint IDENTITY(1,1) NOT NULL CONSTRAINT PK_DashboardChartPrivacyReview PRIMARY KEY,
   DashboardId bigint NOT NULL,
   QueryId bigint NOT NULL,
   DatasetId bigint NOT NULL,
   SourceKey nvarchar(64) NOT NULL,
   CategoryColumn nvarchar(128) NOT NULL,
   ValueColumn nvarchar(128) NOT NULL,
   QueryRevision binary(8) NOT NULL,
   DatasetRevision binary(8) NOT NULL,
   PolicyRevision char(64) COLLATE Latin1_General_100_BIN2 NOT NULL,
   Status varchar(20) NOT NULL,
   MinimumCellCount int NOT NULL CONSTRAINT DF_ChartReview_Minimum DEFAULT(0),
   CategoryPrivacyReviewed bit NOT NULL CONSTRAINT DF_ChartReview_Category DEFAULT(0),
   DifferencingRiskReviewed bit NOT NULL CONSTRAINT DF_ChartReview_Differencing DEFAULT(0),
   RequestedByUserId bigint NOT NULL,
   RequestedAtUtc datetime2(3) NOT NULL CONSTRAINT DF_ChartReview_RequestedAt DEFAULT SYSUTCDATETIME(),
   ReviewerUserId bigint NULL,
   ReviewedAtUtc datetime2(3) NULL,
   ValidUntilUtc datetime2(3) NULL,
   AuditLogId bigint NOT NULL,
   ReviewRowVersion rowversion NOT NULL,
   CONSTRAINT FK_ChartReview_Dashboard FOREIGN KEY(DashboardId) REFERENCES uqp.Dashboard(Id),
   CONSTRAINT FK_ChartReview_Query FOREIGN KEY(QueryId) REFERENCES uqp.QueryDefinition(Id),
   CONSTRAINT FK_ChartReview_Dataset FOREIGN KEY(DatasetId) REFERENCES uqp.Dataset(Id),
   CONSTRAINT FK_ChartReview_Requester FOREIGN KEY(RequestedByUserId) REFERENCES uqp.AppUser(Id),
   CONSTRAINT FK_ChartReview_Reviewer FOREIGN KEY(ReviewerUserId) REFERENCES uqp.AppUser(Id),
   CONSTRAINT CK_ChartReview_State CHECK(
    (Status='REQUESTED' AND MinimumCellCount=0 AND CategoryPrivacyReviewed=0
     AND DifferencingRiskReviewed=0 AND ReviewerUserId IS NULL AND
     ReviewedAtUtc IS NULL AND ValidUntilUtc IS NULL)
    OR (Status IN ('APPROVED','REVOKED') AND MinimumCellCount BETWEEN 5 AND 1000
     AND CategoryPrivacyReviewed=1 AND DifferencingRiskReviewed=1
     AND ReviewerUserId IS NOT NULL AND ReviewerUserId<>RequestedByUserId
     AND ReviewedAtUtc IS NOT NULL AND ValidUntilUtc IS NOT NULL
     AND (Status='REVOKED' OR
      (ValidUntilUtc>ReviewedAtUtc AND
       DATEDIFF_BIG(millisecond,ReviewedAtUtc,ValidUntilUtc) BETWEEN 1 AND 7776000000)))
   ),
   CONSTRAINT CK_ChartReview_Scope CHECK (
    LEN(SourceKey) BETWEEN 1 AND 64 AND LEN(CategoryColumn) BETWEEN 1 AND 128
    AND LEN(ValueColumn) BETWEEN 1 AND 128 AND CategoryColumn<>ValueColumn
    AND LEN(PolicyRevision)=64 AND PolicyRevision NOT LIKE '%[^0-9a-f]%'
   )
  );
  CREATE UNIQUE INDEX UX_ChartReview_Active
    ON uqp.DashboardChartPrivacyReview
      (DashboardId,QueryId,DatasetId,SourceKey,CategoryColumn,ValueColumn)
    WHERE Status IN ('REQUESTED','APPROVED');
  CREATE INDEX IX_ChartReview_Dashboard ON
    uqp.DashboardChartPrivacyReview(DashboardId,Status,Id);
  ALTER TABLE uqp.DashboardWidget DROP CONSTRAINT CK_DashboardWidget_Type;
  -- Type registered, but AFTER trigger below still refuses all CHART DML.
  ALTER TABLE uqp.DashboardWidget WITH CHECK ADD CONSTRAINT CK_DashboardWidget_Type CHECK
   (WidgetType IN(N'TEXT',N'PARAMETER',N'FIELD',N'CLOCK',N'PAGE_INFO',
                  N'COUNTDOWN',N'TABLE',N'CONTAINER',N'CHART'));
  EXEC(N'CREATE TRIGGER uqp.TR_DashboardWidget_ChartFreeze ON uqp.DashboardWidget AFTER INSERT,UPDATE,DELETE AS
BEGIN
 SET NOCOUNT ON;
 -- CHART type is registered for future migration, never enabled by 928.
 IF EXISTS(SELECT 1 FROM inserted WHERE WidgetType=N''CHART'')
 OR EXISTS(SELECT 1 FROM deleted WHERE WidgetType=N''CHART'')
 OR EXISTS(SELECT 1 FROM inserted i JOIN uqp.DashboardChartWidgetSeal s ON s.WidgetId=i.Id)
 OR EXISTS(SELECT 1 FROM deleted d JOIN uqp.DashboardChartWidgetSeal s ON s.WidgetId=d.Id)
  THROW 51928,''CHART_928_WIDGET_FROZEN'',1;
END');
  EXEC(N'CREATE TRIGGER uqp.TR_ChartSeal_DeleteBlock ON uqp.DashboardChartWidgetSeal AFTER DELETE AS
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(SELECT 1 FROM deleted)
  THROW 51928,''CHART_928_SEAL_DELETE_BLOCKED'',1;
END');
  EXEC(N'CREATE TRIGGER uqp.TR_ChartReview_Transition ON uqp.DashboardChartPrivacyReview AFTER UPDATE,DELETE AS
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(
  SELECT 1 FROM deleted d LEFT JOIN inserted i ON i.Id=d.Id
  WHERE i.Id IS NULL OR i.DashboardId<>d.DashboardId OR i.QueryId<>d.QueryId
   OR i.DatasetId<>d.DatasetId OR i.SourceKey<>d.SourceKey
   OR i.CategoryColumn<>d.CategoryColumn OR i.ValueColumn<>d.ValueColumn
   OR i.QueryRevision<>d.QueryRevision OR i.DatasetRevision<>d.DatasetRevision
   OR i.PolicyRevision<>d.PolicyRevision OR i.RequestedByUserId<>d.RequestedByUserId
   OR i.RequestedAtUtc<>d.RequestedAtUtc
   OR NOT((d.Status=''REQUESTED'' AND i.Status=''APPROVED'')
       OR (d.Status=''APPROVED'' AND i.Status=''REVOKED''))
 )
  THROW 51928,''CHART_928_REVIEW_IMMUTABLE'',1;
END');
  EXEC(N'CREATE TRIGGER uqp.TR_ChartTrustRequest_Immutable ON uqp.DashboardChartTrustRequest AFTER UPDATE,DELETE AS
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(
  SELECT 1 FROM deleted d LEFT JOIN inserted i ON i.RequestId=d.RequestId
  WHERE i.RequestId IS NULL OR i.Action<>d.Action OR i.ActorId<>d.ActorId
   OR d.AuditLogId IS NOT NULL OR i.AuditLogId IS NULL
 )
  THROW 51928,''CHART_928_LEDGER_IMMUTABLE'',1;
END');
  EXEC(N'CREATE TRIGGER uqp.TR_ChartSeal_AuditReceipt ON uqp.DashboardChartWidgetSeal AFTER INSERT,UPDATE AS
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(SELECT 1 FROM inserted i WHERE NOT EXISTS
  (SELECT 1 FROM uqp.AuditLog a WITH(HOLDLOCK)
   WHERE a.Id=i.AuditLogId AND a.UserId=i.SealedBy
     AND a.EventType=N''CHART_SEAL_WIDGET'' AND a.Status=N''SUCCESS'' AND a.IsImportant=1))
  THROW 51928,''CHART_928_SEAL_AUDIT_REQUIRED'',1;
END');
  EXEC(N'CREATE TRIGGER uqp.TR_ChartReview_AuditReceipt ON uqp.DashboardChartPrivacyReview AFTER INSERT,UPDATE AS
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(SELECT 1 FROM inserted i WHERE NOT EXISTS
  (SELECT 1 FROM uqp.AuditLog a WITH(HOLDLOCK)
   WHERE a.Id=i.AuditLogId AND a.Status=N''SUCCESS'' AND a.IsImportant=1
     AND a.EventType=CASE i.Status
       WHEN ''REQUESTED'' THEN N''CHART_REQUEST_REVIEW''
       WHEN ''APPROVED'' THEN N''CHART_APPROVE_REVIEW''
       WHEN ''REVOKED'' THEN N''CHART_REVOKE_REVIEW'' ELSE N''INVALID'' END
     AND a.UserId=CASE WHEN i.Status=''REQUESTED'' THEN i.RequestedByUserId
       ELSE i.ReviewerUserId END))
  THROW 51928,''CHART_928_REVIEW_AUDIT_REQUIRED'',1;
END');
  EXEC(N'CREATE TRIGGER uqp.TR_ChartTrustRequest_AuditReceipt ON uqp.DashboardChartTrustRequest AFTER INSERT,UPDATE AS
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(SELECT 1 FROM inserted i WHERE i.AuditLogId IS NOT NULL
    AND NOT EXISTS(SELECT 1 FROM uqp.AuditLog a WITH(HOLDLOCK)
     WHERE a.Id=i.AuditLogId AND a.UserId=i.ActorId AND a.EventType=N''CHART_''+i.Action
       AND a.Status=N''SUCCESS'' AND a.IsImportant=1))
  THROW 51928,''CHART_928_REQUEST_AUDIT_REQUIRED'',1;
END');
 END;
 -- Never silently adopt a partial or disabled schema.
 IF (SELECT COUNT(*) FROM sys.tables WHERE object_id IN
     (OBJECT_ID(N'uqp.DashboardChartWidgetSeal'),OBJECT_ID(N'uqp.DashboardChartPrivacyReview'),
      OBJECT_ID(N'uqp.DashboardChartTrustRequest')))<>3
    OR (SELECT COUNT(*) FROM sys.columns WHERE object_id=OBJECT_ID(N'uqp.DashboardChartWidgetSeal'))<>7
    OR (SELECT COUNT(*) FROM sys.columns WHERE object_id=OBJECT_ID(N'uqp.DashboardChartTrustRequest'))<>4
    OR (SELECT COUNT(*) FROM sys.columns WHERE object_id=OBJECT_ID(N'uqp.DashboardChartPrivacyReview'))<>21
  THROW 51928,'CHART_928_CATALOG_COLUMNS_MISMATCH',1;
 IF NOT EXISTS (SELECT 1 FROM sys.check_constraints WHERE
    parent_object_id=OBJECT_ID(N'uqp.DashboardWidget') AND name=N'CK_DashboardWidget_Type'
    AND is_disabled=0 AND is_not_trusted=0 AND is_not_for_replication=0
    AND definition LIKE N'%CHART%')
  THROW 51928,'CHART_928_WIDGET_TYPE_CONSTRAINT_INVALID',1;
 IF (SELECT COUNT(*) FROM sys.foreign_keys
    WHERE parent_object_id=OBJECT_ID(N'uqp.DashboardChartWidgetSeal')
      AND is_disabled=0 AND is_not_trusted=0 AND delete_referential_action=0)<>2
    OR (SELECT COUNT(*) FROM sys.foreign_keys WHERE
      parent_object_id=OBJECT_ID(N'uqp.DashboardChartPrivacyReview')
      AND is_disabled=0 AND is_not_trusted=0 AND delete_referential_action=0)<>5
    OR (SELECT COUNT(*) FROM sys.foreign_keys WHERE
      parent_object_id=OBJECT_ID(N'uqp.DashboardChartTrustRequest')
      AND is_disabled=0 AND is_not_trusted=0 AND delete_referential_action=0)<>1
  THROW 51928,'CHART_928_FOREIGN_KEY_INVALID',1;
 IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE
    object_id=OBJECT_ID(N'uqp.DashboardChartPrivacyReview')
    AND name=N'UX_ChartReview_Active' AND is_unique=1 AND has_filter=1
    AND is_disabled=0 AND filter_definition LIKE N'%REQUESTED%'
    AND filter_definition LIKE N'%APPROVED%')
  THROW 51928,'CHART_928_ACTIVE_UNIQUE_INDEX_INVALID',1;
 IF (SELECT COUNT(*) FROM sys.triggers WHERE
    (object_id=OBJECT_ID(N'uqp.TR_DashboardWidget_ChartFreeze',N'TR') AND
     parent_id=OBJECT_ID(N'uqp.DashboardWidget') AND is_disabled=0)
    OR (object_id=OBJECT_ID(N'uqp.TR_ChartSeal_DeleteBlock',N'TR') AND
     parent_id=OBJECT_ID(N'uqp.DashboardChartWidgetSeal') AND is_disabled=0)
    OR (object_id=OBJECT_ID(N'uqp.TR_ChartReview_Transition',N'TR') AND
     parent_id=OBJECT_ID(N'uqp.DashboardChartPrivacyReview') AND is_disabled=0)
    OR (object_id=OBJECT_ID(N'uqp.TR_ChartTrustRequest_Immutable',N'TR') AND
     parent_id=OBJECT_ID(N'uqp.DashboardChartTrustRequest') AND is_disabled=0)
    OR (object_id=OBJECT_ID(N'uqp.TR_ChartSeal_AuditReceipt',N'TR') AND
     parent_id=OBJECT_ID(N'uqp.DashboardChartWidgetSeal') AND is_disabled=0)
    OR (object_id=OBJECT_ID(N'uqp.TR_ChartReview_AuditReceipt',N'TR') AND
     parent_id=OBJECT_ID(N'uqp.DashboardChartPrivacyReview') AND is_disabled=0)
    OR (object_id=OBJECT_ID(N'uqp.TR_ChartTrustRequest_AuditReceipt',N'TR') AND
     parent_id=OBJECT_ID(N'uqp.DashboardChartTrustRequest') AND is_disabled=0))<>7
  THROW 51928,'CHART_928_TRIGGERS_REQUIRED',1;
 IF @ownsTransaction=1 COMMIT TRANSACTION;
END TRY
BEGIN CATCH
 IF @ownsTransaction=1 AND XACT_STATE()<>0 ROLLBACK TRANSACTION;
 ELSE IF @ownsTransaction=0 AND XACT_STATE()=1 ROLLBACK TRANSACTION Chart928Draft;
 -- Do not auto-retry or adopt a partially applied migration.
 THROW;
END CATCH;
